---
import { getEntry } from 'astro:content'
import { getSlug } from '@chassis-ui/docs'
import ResponsiveImage from '@chassis-ui/docs/components/ResponsiveImage.astro'

const { img, alt, wide } = Astro.props

// Get component and tab from URL
const path = Astro.url.pathname
const matches = path.match(/\/figma\/docs\/components\/([^\/]+)\/([^\/]+)/)

let frontmatter = null
let component = null
if (matches) {
  const [, comp, tab] = matches
  component = comp
  const entry = await getEntry('figma', `${comp}/${tab}`)
  frontmatter = entry?.data
}

// Construct image path - img prop should contain full filename with extension
const imageSrc = component
  ? `/static/images/figma/${component}/${img}`
  : `https://placehold.co/256x96`
---

<div class={`cx-variant` + (wide ? ` wide` : '')}>
  <div class="cxd-example">
    <ResponsiveImage
      imgPath={`${imageSrc}.png`}
      alt={alt ? alt : `${frontmatter?.title} variant example image`}
      classes="visible-light"
    />
    <ResponsiveImage
      imgPath={`${imageSrc}-dark.png`}
      alt={alt ? alt : `${frontmatter?.title} variant example image`}
      classes="visible-dark"
    />
  </div>
  <div class="cxd-variant-content">
    <slot />
  </div>
</div>
