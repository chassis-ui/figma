---
import ResponsiveImage from '@chassis-ui/docs/components/ResponsiveImage.astro'
import { formatImageAlt } from '@libs/figma'

const { img, alt, wide, lg, neutral } = Astro.props

// Get component from URL
const path = Astro.url.pathname
const component = path.match(/\/figma\/docs\/components\/([^/]+)/)?.[1]
const imageAlt = alt ? alt : formatImageAlt(img)
---

<div
  class={`cx-variant mb-xl pt-xl border-top border-subtle` +
    (wide ? ` flex-column-reverse gap-md` : ' xl:gap-xl')}
>
  <div
    class={`cxd-example p-md xl:p-3xl align-content-center m-0` +
      (!wide ? (lg ? ` flex-shrink-0 xl:w-7/12` : ' flex-shrink-0 xl:w-5/12') : '') +
      (neutral ? ' neutral-bg-highlight' : '')}
  >
    <ResponsiveImage
      imgPath={`/static/images/figma/components/${component}/light/${img}.png`}
      alt={imageAlt}
      classes="visible-light fluid mw-100"
    />
    <ResponsiveImage
      imgPath={`/static/images/figma/components/${component}/dark/${img}.png`}
      alt={imageAlt}
      classes="visible-dark fluid mw-100"
    />
  </div>
  <div class="cxd-variant-content">
    <slot />
  </div>
</div>
