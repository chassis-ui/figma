---

---

<section class="home-section py-3xl md:py-6xl">
  <div class="container 2xl section-content py-3xl md:py-6xl">
    <div class="grid mb-3xl md:mb-6xl">
      <header
        class="section-header col-span-full lg:col-span-10 lg:col-start-2 xl:col-span-8 xl:col-start-3 text-center"
      >
        <h2 class="section-title font-3xl md:font-4xl lg:font-5xl mb-xs md:mb-sm lg:mb-md">
          Built for Your Team
        </h2>
        <p class="section-body md:font-lg lg:font-xl m-0">
          Whether you're managing product strategy, designing interfaces, or building applications,
          Chassis Figma provides the tools and structure to work faster and more consistently.
        </p>
      </header>
    </div>

    <div class="section-features grid grid-cols-1 lg:grid-cols-3 gap-md md:gap-xl">
      <!-- Product Managers -->
      <div>
        <div class="feature-thumb">
          <svg class="icon feature-icon"><use href="#briefcase-outline"></use></svg>
        </div>
        <h3 class="h4 mb-md">Product Managers</h3>
        <ul class="list-group list-unstyled">
          <li class="d-flex gap-sm">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Validate ideas faster with ready-to-use components</span>
          </li>
          <li class="d-flex gap-sm">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Maintain consistent experience across features</span>
          </li>
          <li class="d-flex gap-sm">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Reduce design-to-development handoff friction</span>
          </li>
          <li class="d-flex gap-sm">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Ship features faster with proven patterns</span>
          </li>
        </ul>
      </div>

      <!-- Designers -->
      <div>
        <div class="feature-thumb">
          <svg class="icon feature-icon"><use href="#palette-outline"></use></svg>
        </div>
        <h3 class="h4 mb-md">Designers</h3>
        <ul class="list-group list-unstyled">
          <li class="d-flex gap-sm">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Focus on solving problems, not building buttons</span>
          </li>
          <li class="d-flex gap-sm">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Create high-fidelity prototypes in hours, not weeks</span>
          </li>
          <li class="d-flex gap-sm">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Customize themes without rebuilding components</span>
          </li>
          <li class="d-flex gap-sm">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Document behaviors with built-in spec templates</span>
          </li>
        </ul>
      </div>

      <!-- Developers -->
      <div>
        <div class="feature-thumb">
          <svg class="icon feature-icon"><use href="#code-outline"></use></svg>
        </div>
        <h3 class="h4 mb-md">Developers</h3>
        <ul class="list-group list-unstyled">
          <li class="d-flex gap-sm">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Clear component anatomy and behavior documentation</span>
          </li>
          <li class="d-flex gap-sm">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Token-based design values ready for code generation</span>
          </li>
          <li class="d-flex gap-sm">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Consistent naming and structure across components</span>
          </li>
          <li class="d-flex gap-sm">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Responsive and accessible patterns built-in</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
