---
import { getChassisDocsPath } from '@libs/path'
import Icon from '@chassis-ui/docs/shortcodes/Icon.astro'
---

<div class="home-section py-3xl md:py-6xl">
  <div class="container 2xl section-content py-3xl md:py-6xl">
    <div class="row justify-content-center mb-3xl md:mb-6xl">
      <header class="section-header col xl:col-10 text-center">
        <p
          class="module-title fg-primary md:font-xl font-mass text-uppercase mb-xs md:mb-sm"
        >
          CHASSIS FIGMA
        </p>
        <h1 class="font-hero mb-sm md:mb-md lg:mb-lg">
          <span class="font-normal">Tokenized Figma Components with</span>
          <span class="d-block">Built-In Documentation</span>
        </h1>
        <p class="font-lead mb-md md:mb-lg">
          30+ UI components, swappable asset layers, and documentation templates—all driven by Figma
          Variables that sync directly with production tokens via Tokens Studio.
        </p>
      </header>
    </div>

    <div
      class="section-features d-flex flex-column gap-md mb-md md:mb-lg col lg:col-6 lg:offset-3"
    >
      <!-- Buttons -->
      <div class="d-grid md:d-flex gap-md md:justify-content-center flex-wrap">
        <a href={getChassisDocsPath('')} class="button primary lg">
          <Icon name="book-open-outline" />
          <span>Get Started</span>
        </a>
        <a
          href="https://www.figma.com/@chassis_ui"
          class="button default lg"
          target="_blank"
          rel="noopener"
        >
          <Icon name="cx-figma" sprite="" />
          <span>View on Figma</span>
        </a>
      </div>
    </div>
  </div>
</div>
