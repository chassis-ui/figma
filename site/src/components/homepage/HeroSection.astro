---
import { getConfig } from '@libs/config'
---

<div class="home-section py-3xlarge py-medium-6xlarge">
  <div class="container-2xlarge section-content py-3xlarge py-medium-6xlarge">
    <div class="row justify-content-center mb-3xlarge mb-medium-6xlarge">
      <header class="section-header col col-xlarge-10 text-center">
        <p
          class="module-title fg-primary font-medium-xlarge font-mass text-uppercase mb-xsmall mb-medium-small"
        >
          CHASSIS FIGMA
        </p>
        <h1 class="font-hero mb-small mb-medium-medium mb-large-large">
          <span class="font-normal">Tokenized Figma Components with</span>
          <span class="d-block">Built-In Documentation</span>
        </h1>
        <p class="font-lead mb-medium mb-medium-large">
          30+ UI components, swappable asset layers, and documentation templates—all driven by Figma
          Variables that sync directly with production tokens via Tokens Studio.
        </p>
      </header>
    </div>

    <div
      class="section-features d-flex flex-column gap-medium mb-medium mb-medium-large col col-large-6 offset-large-3"
    >
      <div class="d-grid d-medium-flex gap-medium justify-content-medium-center flex-wrap">
        <a href="/figma/docs/getting-started/introduction" class="button primary large">
          <svg class="icon" aria-hidden="true"><use href="#book-open-solid"></use></svg>
          <span>Get Started</span>
        </a>
        <a
          href="https://www.figma.com/@chassis"
          class="button default large"
          target="_blank"
          rel="noopener"
        >
          <svg class="icon" aria-hidden="true"><use href="#chassis-icon-solid"></use></svg>
          <span>View on Figma</span>
        </a>
      </div>

      <p class="fg-subtle mb-0 text-center font-medium">
        Currently <strong>v{getConfig().current_version}</strong>
        <span class="px-2xsmall">&middot;</span>
        <a href="https://www.figma.com/@chassis" class="link-secondary" target="_blank"
          >Figma Community</a
        >
        <span class="px-2xsmall">&middot;</span>
        <a href="/figma/getting-started/changelog" class="link-secondary text-nowrap"
          >All releases</a
        >
      </p>
    </div>
  </div>
</div>
