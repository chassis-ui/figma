---
import FigmaLayout from '@layouts/FigmaLayout.astro'
import { getCollection, getEntry, render } from 'astro:content'
import { figmaPages } from '@libs/content'
import type { CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  return figmaPages.map((figmaPage: CollectionEntry<'figma'>) => {
    const [component, tab] = figmaPage.id.split('/')
    return {
      params: {
        slug: `${component}/${tab}`
      },
      props: {
        figmaPage,
        component,
        tab,
        data: figmaPage.data
      }
    }
  })
}

const { figmaPage, component, tab } = Astro.props
const { Content, headings } = await render(figmaPage)

// Load shared component metadata from index.json
const componentEntry = await getEntry('figmaComponents', component)
const sharedData = componentEntry?.data ?? {}

const frontmatter = {
  ...sharedData,
  // Allow per-tab overrides (e.g. toc: false on a specific tab)
  ...figmaPage.data,
  title: component
}

// Get all tabs for this component
const allFigma = await getCollection('figma')
const componentEntries = allFigma.filter((e) => e.id.startsWith(component + '/'))
const tabs = componentEntries.map((e) => e.id.split('/')[1]).sort()
---

<FigmaLayout
  frontmatter={frontmatter}
  headings={headings}
  component={component}
  tab={tab}
  tabs={tabs}
>
  <Content />
</FigmaLayout>
