{
  "name": "@chassis-ui/figma",
  "version": "0.1.0",
  "description": "Figma component libary documentation of Chassis UI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/chassis-ui/figma.git"
  },
  "bugs": {
    "url": "https://github.com/chassis-ui/figma/issues"
  },
  "homepage": "https://chassis-ui.com",
  "author": "Ozgur Gunes <o.gunes@gmail.com>",
  "license": "MIT",
  "keywords": [
    "chassis",
    "figma",
    "design system",
    "library",
    "components"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "astro-build": "astro build --root site && rm -rf _site && cp -r site/dist _site",
    "astro-build:production": "node ../chassis-docs/scripts/update-asset-refs.js && astro build --root site && rm -rf _site && cp -r site/dist _site && node ../chassis-docs/scripts/update-asset-refs.js --restore",
    "dist": "node build/copy-assets.js",
    "build": "node build/copy-assets.js",
    "build:site": "npm run astro-build:production",
    "clean": "rm -rf dist",
    "validate": "eslint build/*.js",
    "test": "node test/build.test.js",
    "dev": "npm run clean && npm run build",
    "dev:site": "npm run astro-dev",
    "stats": "node build/analyze-assets.js",
    "site": "pnpm site:build && pnpm site:lint",
    "site:build": "node build/build-site.js",
    "site:format": "prettier --write --cache site",
    "site:lint": "pnpm site:lint:eslint && pnpm site:lint:fusv && pnpm site:lint:stylelint && pnpm site:lint:prettier && pnpm site:lint:vnu",
    "site:lint:fusv": "find-unused-sass-variables site/src/scss/",
    "site:lint:eslint": "prettier -c --cache site",
    "site:lint:stylelint": "stylelint site/src/scss/ --cache --cache-location .cache/.stylelintcache",
    "site:lint:vnu": "node build/vnu-jar.js",
    "astro:dev": "astro dev --root site --port 4326",
    "astro:build": "astro build --root site",
    "astro:preview": "astro preview --root site",
    "check": "pnpm check:code & pnpm check:lockfile & pnpm check:pnpm & wait",
    "check:code": "pnpm site:lint",
    "check:lockfile": "lockfile-lint --allowed-hosts npm --allowed-schemes https: --empty-hostname false --type npm --path package-lock.json",
    "check:pnpm": "pnpm audit --audit-level moderate",
    "release-version": "node build/bump-version.js",
    "release": "pnpm run clean && pnpm run build && pnpm run test",
    "sync:submodules": "node build/sync-submodules.js"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdown-remark": "^6.3.6",
    "@astrojs/mdx": "^4.3.5",
    "@astrojs/prism": "^3.3.0",
    "@astrojs/sitemap": "^3.6.0",
    "@chassis-ui/css": "github:chassis-ui/css#app/docs",
    "@chassis-ui/docs": "^0.1.3",
    "@chassis-ui/icons": "github:chassis-ui/icons#app/docs",
    "@chassis-ui/tokens": "github:chassis-ui/tokens#app/docs",
    "@docsearch/css": "^3.9.0",
    "@docsearch/js": "^3.9.0",
    "@eslint/js": "^9.36.0",
    "@stackblitz/sdk": "^1.11.0",
    "@types/google.analytics": "^0.0.46",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.18.6",
    "@types/prismjs": "^1.26.5",
    "astro": "^5.13.9",
    "astro-auto-import": "^0.4.4",
    "autoprefixer": "^10.4.21",
    "clean-css-cli": "^5.6.3",
    "clipboard": "^2.0.11",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unicorn": "^61.0.2",
    "find-unused-sass-variables": "^6.1.0",
    "github-slugger": "^2.0.0",
    "globals": "^16.4.0",
    "htmlparser2": "^10.0.0",
    "image-size": "^2.0.2",
    "js-yaml": "^4.1.0",
    "lockfile-lint": "^4.14.1",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-mdx-jsx": "^3.2.0",
    "mdast-util-to-string": "^4.0.0",
    "minimist": "^1.2.8",
    "picocolors": "^1.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prismjs": "^1.30.0",
    "rehype-autolink-headings": "^7.1.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "sass": "^1.93.0",
    "standard": "^17.1.2",
    "stylelint": "^16.24.0",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vnu-jar": "23.4.11",
    "zod": "^3.25.76"
  },
  "packageManager": "pnpm@9.15.5+sha512.845196026aab1cc3f098a0474b64dfbab2afe7a1b4e91dd86895d8e4aa32a7a6d03049e2d0ad770bbe4de023a7122fb68c1a1d6e0d033c7076085f9d5d4800d4",
  "dependencies": {
    "remark-definition-list": "^2.0.0"
  }
}
